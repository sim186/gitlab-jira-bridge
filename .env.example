# Copy to .env and fill in. Every value here is referenced from config.yaml as
# ${VAR_NAME}, so secrets never live in the config file itself.

# Secret token configured on the GitLab webhook (min 8 chars).
GITLAB_WEBHOOK_SECRET=change-me-to-the-webhook-token

# Jira bot account (Basic auth user) and its API token from
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=bot@your-org.example
JIRA_API_TOKEN=change-me

# Only for behaviours.comment_on_missing_key. GitLab has no scope narrower than
# "api" that can post comments, so use a dedicated bot user with the Reporter
# role on the projects in scope. Leave empty otherwise.
GITLAB_TOKEN=

# Optional operational overrides.
# GJB_CONFIG=config.yaml
# GJB_DRY_RUN=1     # plan and audit, never write to Jira
# GJB_HOST=0.0.0.0  # the image sets this; the config default is 127.0.0.1
# GJB_PORT=8090
